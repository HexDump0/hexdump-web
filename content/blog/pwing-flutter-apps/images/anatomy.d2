vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 200
  }
}

direction: down

platform-agnostic: Platform-Agnostic {
  style.fill: "#2a2a3e"
  style.stroke: "#555"
  style.stroke-dash: 4
  style.font-size: 16
  style.font-color: "#aaa"
  style.border-radius: 12

  dart-app: "Dart App\n(app repo · Dart)" {
    style.fill: "#FBDDB5"
    style.stroke: "#E0C090"
    style.font-size: 22
    style.font-color: "#333"
    style.border-radius: 8
  }

  framework: "Framework\n(flutter/flutter · Dart)" {
    style.fill: "#C4D4EF"
    style.stroke: "#A0B8D8"
    style.font-size: 22
    style.font-color: "#333"
    style.border-radius: 8
  }

  dart-ui: "dart:ui" {
    style.fill: "#B8A0C8"
    style.stroke: "#9880A8"
    style.font-size: 18
    style.font-color: "#222"
    style.border-radius: 6
  }

  engine: "Engine\n(flutter/flutter · C/C++)" {
    style.fill: "#DDCAE2"
    style.stroke: "#C0AAC8"
    style.font-size: 22
    style.font-color: "#333"
    style.border-radius: 8
  }

  embedder-api: "Embedder API (embedder.h)" {
    style.fill: "#B8A0C8"
    style.stroke: "#9880A8"
    style.font-size: 18
    style.font-color: "#222"
    style.border-radius: 6
  }

  dart-app -> framework -> dart-ui -> engine -> embedder-api {
    style.opacity: 0
  }
}

platform-specific: Platform-Specific {
  style.fill: "#2a2a3e"
  style.stroke: "#555"
  style.stroke-dash: 4
  style.font-size: 16
  style.font-color: "#aaa"
  style.border-radius: 12

  embedder: "Embedder\n(flutter/flutter)" {
    style.fill: "#B5D8A8"
    style.stroke: "#90C080"
    style.font-size: 22
    style.font-color: "#333"
    style.border-radius: 8
  }

  platform-api: "Platform-specific API" {
    style.fill: "#3D8040"
    style.stroke: "#2D6830"
    style.font-size: 18
    style.font-color: "#fff"
    style.border-radius: 6
  }

  runner: "Runner\n(app repo)" {
    style.fill: "#FBDDB5"
    style.stroke: "#E0C090"
    style.font-size: 22
    style.font-color: "#333"
    style.border-radius: 8
  }

  embedder -> platform-api -> runner {
    style.opacity: 0
  }
}

platform-agnostic -> platform-specific {
  style.opacity: 0
}
